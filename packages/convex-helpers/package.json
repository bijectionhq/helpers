{
  "name": "@bijectionhq/helpers",
  "version": "0.1.128",
  "description": "A collection of useful code to complement the official Bijection package.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./validators": {
      "types": "./validators.d.ts",
      "default": "./validators.js"
    },
    "./standardSchema": {
      "types": "./standardSchema.d.ts",
      "default": "./standardSchema.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./server/pagination": {
      "types": "./server/pagination.d.ts",
      "default": "./server/pagination.js"
    },
    "./server/stream": {
      "types": "./server/stream.d.ts",
      "default": "./server/stream.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.bijection.json",
    "typecheck": "tsc --noEmit -p tsconfig.bijection.json",
    "test": "vitest run index.test.ts validators.test.ts standardSchema.test.ts server/pagination.test.ts server/stream.test.ts --globals --maxWorkers=1 --no-file-parallelism"
  },
  "repository": "github:bijectionhq/helpers",
  "keywords": [
    "convex",
    "backend",
    "migrations",
    "ratelimit",
    "database",
    "react"
  ],
  "author": "Ian Macartney <ian@convex.dev>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bijectionhq/helpers/issues"
  },
  "homepage": "https://github.com/bijectionhq/helpers",
  "peerDependencies": {
    "@standard-schema/spec": "^1.0.0",
    "hono": "^4.0.5",
    "react": "^17.0.2 || ^18.0.0 || ^19.0.0",
    "typescript": "^5.5 || ^6.0.0 || ^7.0.0",
    "zod": "^3.25.0 || ^4.0.0",
    "bijection": "^0.1.5"
  },
  "peerDependenciesMeta": {
    "@standard-schema/spec": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "bijection": {
      "optional": true
    }
  }
}
